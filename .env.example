# Copia este archivo como ".env" para desarrollo local (no lo subas al repositorio).
# En Render estas variables se cargan desde el panel (Environment), NO desde un archivo.

# Cadena de conexion de MongoDB Atlas.
# Recomendado el formato SRV:
#   mongodb+srv://USUARIO:PASSWORD@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=

# Contraseña para desbloquear el panel de administracion.
ADMIN_PASSWORD=

# PORT es opcional en local (por defecto 3000). En Render lo define la plataforma.
# PORT=3000
